# Copy to .env.local. Never commit real values.
NEXTAUTH_URL=http://127.0.0.1:8099
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google verified Gmail / Workspace administrator email addresses, comma separated.
ADMIN_EMAILS=
# Optional stable Google account subject IDs. Required for non-Gmail/Workspace accounts.
ADMIN_GOOGLE_SUBS=
# Absolute persistent directory OUTSIDE this repository. Example on Windows:
DATA_DIR=C:/DataAnalysis/nondam-homepage-data
